generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../shared/data/stock/stocklens_prisma.sqlite"
}

model ShopInfo {
  id           Int      @id
  shopCode     String   @unique @map("shop_code")
  shopName     String   @map("shop_name")
  areaName     String?  @map("area_name")
  city         String?
  state        String?
  pincode      String?
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  nilLocation  Int?     @map("nil_location")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  nilLocationRef ShopLocation? @relation(fields: [nilLocation], references: [id], onDelete: SetNull)

  @@map("shop_info")
}

model ShopLocation {
  id                           Int      @id @default(autoincrement())
  locationCode                 String   @unique @map("location_code")
  locationName                 String   @map("location_name")
  locationType                 String?  @map("location_type")
  locationColor                String   @default("#2563eb") @map("location_color")
  sortOrder                    Int      @default(0) @map("sort_order")
  lowStockNotificationsEnabled Boolean  @default(true) @map("low_stock_notifications_enabled")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  unfinishedStocks CycleUnfinishedStock[]
  finishedStocks   CycleFinishedStock[]
  diffBatches      DiffBatch[]
  diffItems        DiffItem[]
  events           CycleProductEvent[]
  nilForShop       ShopInfo[]
  lowStockConfig   LowStockLocationConfig?
  lowStockPackRules    LowStockPackRule[]
  lowStockBrandRules   LowStockBrandRule[]
  lowStockProductRules LowStockProductRule[]
  lowStockNotificationRuns LowStockNotificationRun[]
  lowStockProductNotificationStates LowStockProductNotificationState[]
  highStockConfig   HighStockLocationConfig?
  highStockPackRules    HighStockPackRule[]
  highStockBrandRules   HighStockBrandRule[]
  highStockProductRules HighStockProductRule[]
  nilStockConfig   NilStockLocationConfig?
  nilStockNotificationRuns NilStockNotificationRun[]
  nilStockProductNotificationStates NilStockProductNotificationState[]
  fcmDeviceTokens      FcmDeviceToken[]

  @@map("shop_locations")
}

model Cycle {
  id        Int      @id @default(autoincrement())
  sno       Int?
  startDate DateTime @unique @map("start_date")
  endDate   DateTime? @map("end_date")
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unfinishedStocks CycleUnfinishedStock[]
  finishedStocks   CycleFinishedStock[]
  diffBatches      DiffBatch[]
  diffItems        DiffItem[]
  events           CycleProductEvent[]
  operatorDailyMismatchSummaries OperatorDailyMismatchSummary[]

  @@index([status, startDate], map: "idx_cycles_status_start_date")
  @@map("cycles")
}

model CycleUnfinishedStock {
  id                    Int      @id @default(autoincrement())
  cycleId               Int      @map("cycle_id")
  itemCode              String   @map("item_code")
  itemName              String?  @map("item_name")
  brandName             String?  @map("brand_name")
  packValue             String?  @map("pack_value")
  bpc                   Int?
  mrp                   Float?
  barcode               String?
  phoneId               Int?     @map("phone_id")
  phoneName             String?  @map("phone_name")
  shopLocationId        Int      @map("shop_location_id")
  activityDate          DateTime @map("activity_date")
  quantityBottles       Int      @default(0) @map("quantity_bottles")
  currentStockBottles   Int      @default(0) @map("current_stock_bottles")
  diffBottles           Int      @default(0) @map("diff_bottles")
  isMatched             Boolean  @default(false) @map("is_matched")
  recheckShown          Boolean  @default(false) @map("recheck_shown")
  lastUpdatedByWorkerId Int?     @map("last_updated_by_worker_id")
  stateUpdatedAt        DateTime @default(now()) @map("state_updated_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  cycle         Cycle         @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  shopLocation  ShopLocation  @relation(fields: [shopLocationId], references: [id], onDelete: Restrict)
  lastUpdatedBy Worker?       @relation("UnfinishedUpdatedBy", fields: [lastUpdatedByWorkerId], references: [id], onDelete: SetNull)
  phone         Phone?        @relation("UnfinishedPhone", fields: [phoneId], references: [id], onDelete: SetNull)
  events        CycleProductEvent[] @relation("UnfinishedEvents")
  finishedRefs  CycleFinishedStock[] @relation("SourceUnfinished")

  @@unique([cycleId, itemCode, shopLocationId, activityDate], map: "uniq_cycle_unfinished_stock")
  @@index([cycleId, itemCode, shopLocationId, activityDate], map: "idx_cycle_unfinished_lookup")
  @@map("cycle_unfinished_stock")
}

model CycleFinishedStock {
  id                    Int      @id @default(autoincrement())
  cycleId               Int      @map("cycle_id")
  itemCode              String   @map("item_code")
  itemName              String?  @map("item_name")
  brandName             String?  @map("brand_name")
  packValue             String?  @map("pack_value")
  bpc                   Int?
  mrp                   Float?
  barcode               String?
  phoneId               Int?      @map("phone_id")
  phoneName             String?  @map("phone_name")
  shopLocationId        Int      @map("shop_location_id")
  activityDate          DateTime @map("activity_date")
  quantityBottles       Int      @default(0) @map("quantity_bottles")
  currentStockBottles   Int      @default(0) @map("current_stock_bottles")
  diffBottles           Int      @default(0) @map("diff_bottles")
  isMatched             Boolean  @default(false) @map("is_matched")
  matchedAt             DateTime? @map("matched_at")
  lastUpdatedByWorkerId Int?      @map("last_updated_by_worker_id")
  finishedAt            DateTime  @default(now()) @map("finished_at")
  finishedByWorkerId    Int?      @map("finished_by_worker_id")
  sourceUnfinishedId    Int?      @map("source_unfinished_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  cycle            Cycle               @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  shopLocation     ShopLocation        @relation(fields: [shopLocationId], references: [id], onDelete: Restrict)
  lastUpdatedBy    Worker?             @relation("FinishedUpdatedBy", fields: [lastUpdatedByWorkerId], references: [id], onDelete: SetNull)
  phone            Phone?              @relation("FinishedPhone", fields: [phoneId], references: [id], onDelete: SetNull)
  finishedBy       Worker?             @relation("FinishedBy", fields: [finishedByWorkerId], references: [id], onDelete: SetNull)
  sourceUnfinished CycleUnfinishedStock? @relation("SourceUnfinished", fields: [sourceUnfinishedId], references: [id], onDelete: SetNull)
  events           CycleProductEvent[] @relation("FinishedEvents")

  @@unique([cycleId, itemCode, shopLocationId, activityDate], map: "uniq_cycle_finished_stock")
  @@index([cycleId, itemCode, shopLocationId, activityDate], map: "idx_cycle_finished_lookup")
  @@map("cycle_finished_stock")
}

model CycleProductEvent {
  id                 Int      @id @default(autoincrement())
  cycleId            Int      @map("cycle_id")
  itemCode           String   @map("item_code")
  itemName           String?  @map("item_name")
  brandName          String?  @map("brand_name")
  packValue          String?  @map("pack_value")
  shopLocationId     Int      @map("shop_location_id")
  cycleUnfinishedId  Int?     @map("cycle_unfinished_id")
  cycleFinishedId    Int?     @map("cycle_finished_id")
  activityDate       DateTime @map("activity_date")
  eventTime          DateTime @default(now()) @map("event_time")
  eventScope         String   @map("event_scope")
  eventAction        String   @map("event_action")
  matched            Boolean?
  stockBottlesAfter  Int?     @map("stock_bottles_after")
  currentStockBottles Int?    @map("current_stock_bottles")
  diffBottles        Int?     @map("diff_bottles")
  changesJson        String?  @map("changes_json")
  workerId           Int?     @map("worker_id")
  deviceId           Int?     @map("device_id")
  phoneId           Int?      @map("phone_id")
  shopName           String?  @map("shop_name")
  phoneName          String?  @map("phone_name")
  createdAt          DateTime @default(now()) @map("created_at")

  cycle            Cycle               @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  shopLocation     ShopLocation        @relation(fields: [shopLocationId], references: [id], onDelete: Restrict)
  unfinished       CycleUnfinishedStock? @relation("UnfinishedEvents", fields: [cycleUnfinishedId], references: [id], onDelete: SetNull)
  finished         CycleFinishedStock?   @relation("FinishedEvents", fields: [cycleFinishedId], references: [id], onDelete: SetNull)
  worker           Worker?             @relation(fields: [workerId], references: [id], onDelete: SetNull)
  device           Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  phone            Phone?              @relation(fields: [phoneId], references: [id], onDelete: SetNull)

  @@index([cycleId, itemCode, shopLocationId, eventTime], map: "idx_cycle_product_events_lookup")
  @@map("cycle_product_events")
}

model Worker {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  fatherName            String?  @map("father_name")
  designationId         Int?     @map("designation_id")
  dateOfBirth           DateTime? @map("date_of_birth")
  dateOfJoining         DateTime? @map("date_of_joining")
  dateOfResignation     DateTime? @map("date_of_resignation")
  permanentAddress      String?  @map("permanent_address")
  temporaryAddress      String?  @map("temporary_address")
  aadhaarNumber         String?  @map("aadhaar_number")
  email                 String?
  bankAccountNumber     String?  @map("bank_account_number")
  ifscCode              String?  @map("ifsc_code")
  recommendedBy         String   @default("Direct") @map("recommended_by")
  workLocationId        Int?     @map("work_location_id")
  profileImageBase64    String?  @map("profile_image_base64")
  profileImageMimeType  String?  @map("profile_image_mime_type")
  profileImageFileName  String?  @map("profile_image_file_name")
  resumeFileBase64      String?  @map("resume_file_base64")
  resumeFileMimeType    String?  @map("resume_file_mime_type")
  resumeFileName        String?  @map("resume_file_name")
  aadhaarImageBase64    String?  @map("aadhaar_image_base64")
  aadhaarImageMimeType  String?  @map("aadhaar_image_mime_type")
  aadhaarImageFileName  String?  @map("aadhaar_image_file_name")
  phone                 String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  unfinishedUpdatedRows CycleUnfinishedStock[] @relation("UnfinishedUpdatedBy")
  finishedUpdatedRows   CycleFinishedStock[]   @relation("FinishedUpdatedBy")
  finishedByRows        CycleFinishedStock[]   @relation("FinishedBy")
  diffCreatedBatches    DiffBatch[]            @relation("DiffBatchCreatedBy")
  diffUpdatedRows       DiffItem[]             @relation("DiffUpdatedBy")
  diffFinishedByRows    DiffItem[]             @relation("DiffFinishedBy")
  events                CycleProductEvent[]
  operatorDailyMismatchSummaries OperatorDailyMismatchSummary[]
  designation           WorkerDesignation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  workLocation          WorkerWorkLocation?    @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  phoneNumbers          WorkerPhoneNumber[]
  documents             WorkerDocument[]

  @@index([designationId], map: "idx_workers_designation_id")
  @@index([workLocationId], map: "idx_workers_work_location_id")
  @@index([active], map: "idx_workers_active")

  @@map("workers")
}

model WorkerDesignation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workers Worker[]

  @@map("worker_designations")
}

model WorkerWorkLocation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workers Worker[]

  @@map("worker_work_locations")
}

model WorkerPhoneNumber {
  id          Int      @id @default(autoincrement())
  workerId    Int      @map("worker_id")
  label       String?
  phoneNumber String   @map("phone_number")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId], map: "idx_worker_phone_numbers_worker_id")
  @@index([workerId, isPrimary], map: "idx_worker_phone_numbers_primary")
  @@map("worker_phone_numbers")
}

model WorkerDocument {
  id             Int      @id @default(autoincrement())
  workerId       Int      @map("worker_id")
  category       String
  label          String?
  textValue      String?  @map("text_value")
  fileName       String?  @map("file_name")
  mimeType       String?  @map("mime_type")
  fileDataBase64 String?  @map("file_data_base64")
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId], map: "idx_worker_documents_worker_id")
  @@index([workerId, category], map: "idx_worker_documents_category")
  @@map("worker_documents")
}

model Device {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  model     String?
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events CycleProductEvent[]

  @@map("devices")
}

model Phone {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  lowStockNotificationsEnabled Boolean @default(true) @map("low_stock_notifications_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unfinishedRows CycleUnfinishedStock[] @relation("UnfinishedPhone")
  finishedRows   CycleFinishedStock[]   @relation("FinishedPhone")
  diffRows       DiffItem[]             @relation("DiffPhone")
  events         CycleProductEvent[]
  fcmDeviceTokens FcmDeviceToken[]

  @@map("phones")
}

model DiffBatch {
  id                Int      @id @default(autoincrement())
  cycleId           Int      @map("cycle_id")
  shopLocationId    Int      @map("shop_location_id")
  createdByWorkerId Int?     @map("created_by_worker_id")
  proofImagePath    String?  @map("proof_image_path")
  proofImageName    String?  @map("proof_image_name")
  itemCount         Int      @default(0) @map("item_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  cycle        Cycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Restrict)
  createdBy    Worker?      @relation("DiffBatchCreatedBy", fields: [createdByWorkerId], references: [id], onDelete: SetNull)
  items        DiffItem[]

  @@index([cycleId, shopLocationId], map: "idx_diff_batches_cycle_location")
  @@map("diff_batches")
}

model DiffItem {
  id                    Int      @id @default(autoincrement())
  diffBatchId           Int      @map("diff_batch_id")
  sourceScope           String   @map("source_scope")
  sourceUnfinishedId    Int?     @map("source_unfinished_id")
  sourceFinishedId      Int?     @map("source_finished_id")
  cycleId               Int      @map("cycle_id")
  itemCode              String   @map("item_code")
  itemName              String?  @map("item_name")
  brandName             String?  @map("brand_name")
  packValue             String?  @map("pack_value")
  bpc                   Int?
  mrp                   Float?
  barcode               String?
  phoneId               Int?     @map("phone_id")
  phoneName             String?  @map("phone_name")
  shopLocationId        Int      @map("shop_location_id")
  activityDate          DateTime @map("activity_date")
  quantityBottles       Int      @default(0) @map("quantity_bottles")
  currentStockBottles   Int      @default(0) @map("current_stock_bottles")
  diffBottles           Int      @default(0) @map("diff_bottles")
  isMatched             Boolean  @default(false) @map("is_matched")
  matchedAt             DateTime? @map("matched_at")
  lastUpdatedByWorkerId Int?      @map("last_updated_by_worker_id")
  finishedAt            DateTime? @map("finished_at")
  finishedByWorkerId    Int?      @map("finished_by_worker_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  diffBatch     DiffBatch    @relation(fields: [diffBatchId], references: [id], onDelete: Cascade)
  cycle         Cycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  shopLocation  ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Restrict)
  lastUpdatedBy Worker?      @relation("DiffUpdatedBy", fields: [lastUpdatedByWorkerId], references: [id], onDelete: SetNull)
  finishedBy    Worker?      @relation("DiffFinishedBy", fields: [finishedByWorkerId], references: [id], onDelete: SetNull)
  phone         Phone?       @relation("DiffPhone", fields: [phoneId], references: [id], onDelete: SetNull)

  @@index([diffBatchId], map: "idx_diff_items_batch")
  @@index([cycleId, shopLocationId], map: "idx_diff_items_cycle_location")
  @@map("diff_items")
}

model LowStockLocationConfig {
  id                      Int      @id @default(autoincrement())
  shopLocationId          Int      @unique @map("shop_location_id")
  generalThresholdBottles Int      @default(6) @map("general_threshold_bottles")
  sourceLocationId        Int?     @map("source_location_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@index([sourceLocationId], map: "idx_low_stock_location_config_source_location")
  @@map("low_stock_location_config")
}

model LowStockPackRule {
  id               Int      @id @default(autoincrement())
  shopLocationId   Int      @map("shop_location_id")
  packValue        String   @map("pack_value")
  normalizedPack   String   @map("normalized_pack")
  thresholdBottles Int      @map("threshold_bottles")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, normalizedPack], map: "uniq_low_stock_pack_rule")
  @@index([shopLocationId, thresholdBottles], map: "idx_low_stock_pack_rule_lookup")
  @@map("low_stock_pack_rules")
}

model LowStockBrandRule {
  id               Int      @id @default(autoincrement())
  shopLocationId   Int      @map("shop_location_id")
  brandName        String   @map("brand_name")
  normalizedBrand  String   @map("normalized_brand")
  thresholdBottles Int      @map("threshold_bottles")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, normalizedBrand], map: "uniq_low_stock_brand_rule")
  @@index([shopLocationId, thresholdBottles], map: "idx_low_stock_brand_rule_lookup")
  @@map("low_stock_brand_rules")
}

model LowStockProductRule {
  id               Int      @id @default(autoincrement())
  shopLocationId   Int      @map("shop_location_id")
  itemCode         String   @map("item_code")
  normalizedCode   String   @map("normalized_code")
  thresholdBottles Int      @map("threshold_bottles")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, normalizedCode], map: "uniq_low_stock_product_rule")
  @@index([shopLocationId, thresholdBottles], map: "idx_low_stock_product_rule_lookup")
  @@map("low_stock_product_rules")
}

model HighStockLocationConfig {
  id                      Int      @id @default(autoincrement())
  shopLocationId          Int      @unique @map("shop_location_id")
  generalThresholdBottles Int      @default(0) @map("general_threshold_bottles")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@map("high_stock_location_config")
}

model HighStockPackRule {
  id               Int      @id @default(autoincrement())
  shopLocationId   Int      @map("shop_location_id")
  packValue        String   @map("pack_value")
  normalizedPack   String   @map("normalized_pack")
  thresholdBottles Int      @map("threshold_bottles")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, normalizedPack], map: "uniq_high_stock_pack_rule")
  @@index([shopLocationId, thresholdBottles], map: "idx_high_stock_pack_rule_lookup")
  @@map("high_stock_pack_rules")
}

model HighStockBrandRule {
  id               Int      @id @default(autoincrement())
  shopLocationId   Int      @map("shop_location_id")
  brandName        String   @map("brand_name")
  normalizedBrand  String   @map("normalized_brand")
  thresholdBottles Int      @map("threshold_bottles")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, normalizedBrand], map: "uniq_high_stock_brand_rule")
  @@index([shopLocationId, thresholdBottles], map: "idx_high_stock_brand_rule_lookup")
  @@map("high_stock_brand_rules")
}

model HighStockProductRule {
  id               Int      @id @default(autoincrement())
  shopLocationId   Int      @map("shop_location_id")
  itemCode         String   @map("item_code")
  normalizedCode   String   @map("normalized_code")
  thresholdBottles Int      @map("threshold_bottles")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, normalizedCode], map: "uniq_high_stock_product_rule")
  @@index([shopLocationId, thresholdBottles], map: "idx_high_stock_product_rule_lookup")
  @@map("high_stock_product_rules")
}

model FcmDeviceToken {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  phoneId        Int?     @map("phone_id")
  shopLocationId Int?     @map("shop_location_id")
  active         Boolean  @default(true)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  phone        Phone?        @relation(fields: [phoneId], references: [id], onDelete: SetNull)
  shopLocation ShopLocation? @relation(fields: [shopLocationId], references: [id], onDelete: SetNull)

  @@index([shopLocationId, active], map: "idx_fcm_device_tokens_location_active")
  @@index([phoneId, active], map: "idx_fcm_device_tokens_phone_active")
  @@map("fcm_device_tokens")
}

model LowStockNotificationRun {
  id             Int      @id @default(autoincrement())
  shopLocationId Int      @map("shop_location_id")
  csvVersion     String   @map("csv_version")
  trigger        String?
  status         String   @default("pending")
  lowCount       Int      @default(0) @map("low_count")
  tokenCount     Int      @default(0) @map("token_count")
  successCount   Int      @default(0) @map("success_count")
  failureCount   Int      @default(0) @map("failure_count")
  reason         String?
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, csvVersion], map: "uniq_low_stock_notification_run")
  @@index([csvVersion], map: "idx_low_stock_notification_run_version")
  @@index([shopLocationId, status], map: "idx_low_stock_notification_run_status")
  @@map("low_stock_notification_runs")
}

model LowStockProductNotificationState {
  id               Int      @id @default(autoincrement())
  shopLocationId   Int      @map("shop_location_id")
  itemCode         String   @map("item_code")
  itemName         String   @default("") @map("item_name")
  brandName        String   @default("") @map("brand_name")
  packValue        String   @default("") @map("pack_value")
  displayName      String   @default("") @map("display_name")
  thresholdBottles Int      @default(0) @map("threshold_bottles")
  currentBottles   Int      @default(0) @map("current_bottles")
  isNotified       Boolean  @default(false) @map("is_notified")
  lastNotifiedAt   DateTime? @map("last_notified_at")
  lastRecoveredAt  DateTime? @map("last_recovered_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, itemCode], map: "uniq_low_stock_product_notification_state")
  @@index([shopLocationId, isNotified], map: "idx_low_stock_product_notification_state_lookup")
  @@map("low_stock_product_notification_states")
}

model NilStockLocationConfig {
  id                   Int      @id @default(autoincrement())
  shopLocationId       Int      @unique @map("shop_location_id")
  sourceLocationId     Int?     @map("source_location_id")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@index([sourceLocationId], map: "idx_nil_stock_location_config_source_location")
  @@index([notificationsEnabled], map: "idx_nil_stock_location_config_notifications_enabled")
  @@map("nil_stock_location_config")
}

model NilStockNotificationRun {
  id             Int      @id @default(autoincrement())
  shopLocationId Int      @map("shop_location_id")
  csvVersion     String   @map("csv_version")
  trigger        String?
  status         String   @default("pending")
  nilCount       Int      @default(0) @map("nil_count")
  tokenCount     Int      @default(0) @map("token_count")
  successCount   Int      @default(0) @map("success_count")
  failureCount   Int      @default(0) @map("failure_count")
  reason         String?
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, csvVersion], map: "uniq_nil_stock_notification_run")
  @@index([csvVersion], map: "idx_nil_stock_notification_run_version")
  @@index([shopLocationId, status], map: "idx_nil_stock_notification_run_status")
  @@map("nil_stock_notification_runs")
}

model NilStockProductNotificationState {
  id                   Int      @id @default(autoincrement())
  shopLocationId       Int      @map("shop_location_id")
  sourceLocationId     Int?     @map("source_location_id")
  itemCode             String   @map("item_code")
  itemName             String   @default("") @map("item_name")
  brandName            String   @default("") @map("brand_name")
  packValue            String   @default("") @map("pack_value")
  displayName          String   @default("") @map("display_name")
  sourceCurrentBottles Int      @default(0) @map("source_current_bottles")
  targetCurrentBottles Int      @default(0) @map("target_current_bottles")
  isNotified           Boolean  @default(false) @map("is_notified")
  lastNotifiedAt       DateTime? @map("last_notified_at")
  lastRecoveredAt      DateTime? @map("last_recovered_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  shopLocation ShopLocation @relation(fields: [shopLocationId], references: [id], onDelete: Cascade)

  @@unique([shopLocationId, itemCode], map: "uniq_nil_stock_product_notification_state")
  @@index([shopLocationId, isNotified], map: "idx_nil_stock_product_notification_state_lookup")
  @@index([sourceLocationId], map: "idx_nil_stock_product_notification_state_source_location")
  @@map("nil_stock_product_notification_states")
}

model OperatorDailyMismatchSummary {
  id            Int      @id @default(autoincrement())
  cycleId       Int      @map("cycle_id")
  operatorId    Int      @map("operator_id")
  activityDate  DateTime @map("activity_date")
  mismatchCount Int      @default(0) @map("mismatch_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cycle    Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  operator Worker @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([cycleId, operatorId, activityDate], map: "uniq_operator_daily_mismatch")
  @@index([activityDate], map: "idx_operator_daily_mismatch_date")
  @@index([operatorId, activityDate], map: "idx_operator_daily_mismatch_operator_date")
  @@map("operator_daily_mismatch_summary")
}

model BestSellingProduct {
  id        Int      @id @default(autoincrement())
  itemCode  String   @unique @map("item_code")
  itemName  String?  @map("item_name")
  brandName String?  @map("brand_name")
  packValue String?  @map("pack_value")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("best_selling_products")
}

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Printer {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  ipAddress      String   @unique @map("ip_address")
  port           Int      @default(9100)
  defaultPrinter Boolean  @default(false) @map("default_printer")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("printers")
}
