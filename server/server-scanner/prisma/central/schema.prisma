generator client {
  provider = "prisma-client-js"
  output   = "../../generated/central-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../../shared/data/stock/central_master.sqlite"
}

model Operator {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  fatherName            String?  @map("father_name")
  designationId         Int?     @map("designation_id")
  dateOfBirth           DateTime? @map("date_of_birth")
  dateOfJoining         DateTime? @map("date_of_joining")
  dateOfResignation     DateTime? @map("date_of_resignation")
  permanentAddress      String?  @map("permanent_address")
  temporaryAddress      String?  @map("temporary_address")
  aadhaarNumber         String?  @map("aadhaar_number")
  email                 String?
  bankAccountNumber     String?  @map("bank_account_number")
  ifscCode              String?  @map("ifsc_code")
  recommendedBy         String   @default("Direct") @map("recommended_by")
  workLocationId        Int?     @map("work_location_id")
  profileImageBase64    String?  @map("profile_image_base64")
  profileImageMimeType  String?  @map("profile_image_mime_type")
  profileImageFileName  String?  @map("profile_image_file_name")
  resumeFileBase64      String?  @map("resume_file_base64")
  resumeFileMimeType    String?  @map("resume_file_mime_type")
  resumeFileName        String?  @map("resume_file_name")
  aadhaarImageBase64    String?  @map("aadhaar_image_base64")
  aadhaarImageMimeType  String?  @map("aadhaar_image_mime_type")
  aadhaarImageFileName  String?  @map("aadhaar_image_file_name")
  phone                 String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  designation  OperatorDesignation?  @relation(fields: [designationId], references: [id], onDelete: SetNull)
  workLocation OperatorWorkLocation? @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  phoneNumbers OperatorPhoneNumber[]
  documents    OperatorDocument[]

  @@index([designationId], map: "idx_operators_designation_id")
  @@index([workLocationId], map: "idx_operators_work_location_id")
  @@index([active], map: "idx_operators_active")

  @@map("operators")
}

model OperatorDesignation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  operators Operator[]

  @@map("operator_designations")
}

model OperatorWorkLocation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  operators Operator[]

  @@map("operator_work_locations")
}

model OperatorPhoneNumber {
  id          Int      @id @default(autoincrement())
  operatorId  Int      @map("operator_id")
  label       String?
  phoneNumber String   @map("phone_number")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId], map: "idx_operator_phone_numbers_operator_id")
  @@index([operatorId, isPrimary], map: "idx_operator_phone_numbers_primary")
  @@map("operator_phone_numbers")
}

model OperatorDocument {
  id             Int      @id @default(autoincrement())
  operatorId     Int      @map("operator_id")
  category       String
  label          String?
  textValue      String?  @map("text_value")
  fileName       String?  @map("file_name")
  mimeType       String?  @map("mime_type")
  fileDataBase64 String?  @map("file_data_base64")
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId], map: "idx_operator_documents_operator_id")
  @@index([operatorId, category], map: "idx_operator_documents_category")
  @@map("operator_documents")
}

model BestSeller {
  id        Int      @id @default(autoincrement())
  itemCode  String   @unique @map("item_code")
  itemName  String?  @map("item_name")
  brandName String?  @map("brand_name")
  packValue String?  @map("pack_value")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("best_sellers")
}

model ShopEndpoint {
  id        Int      @id @default(autoincrement())
  shopName  String   @unique @map("shop_name")
  baseUrl   String   @unique @map("base_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_endpoints")
}

model AccessUser {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  role                String   @default("owner")
  active              Boolean  @default(true)
  canAccessMasterData Boolean  @default(true) @map("can_access_master_data")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  otpChallenges AccessOtpChallenge[]
  sessions      AccessSession[]
  auditLogs     AccessAuditLog[]

  @@index([role, active], map: "idx_access_users_role_active")
  @@map("access_users")
}

model AccessOtpChallenge {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  purpose    String   @default("login")
  otpHash    String   @map("otp_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  user AccessUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt], map: "idx_access_otp_challenges_lookup")
  @@map("access_otp_challenges")
}

model AccessSession {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  deviceId          String?   @map("device_id")
  expiresAt         DateTime  @map("expires_at")
  masterAccessUntil DateTime? @map("master_access_until")
  revokedAt         DateTime? @map("revoked_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user AccessUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_access_sessions_user_expires")
  @@index([deviceId, expiresAt], map: "idx_access_sessions_device_expires")
  @@index([revokedAt], map: "idx_access_sessions_revoked")
  @@map("access_sessions")
}

model AccessDevice {
  id                  Int      @id @default(autoincrement())
  deviceId            String   @unique @map("device_id")
  deviceLabel         String   @map("device_label")
  userAgent           String?  @map("user_agent")
  lastSeenEmail       String?  @map("last_seen_email")
  active              Boolean  @default(false)
  canAccessMasterData Boolean  @default(false) @map("can_access_master_data")
  approvedByEmail     String?  @map("approved_by_email")
  approvedAt          DateTime? @map("approved_at")
  lastSeenAt          DateTime @default(now()) @map("last_seen_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([active, canAccessMasterData], map: "idx_access_devices_active_master")
  @@index([lastSeenAt], map: "idx_access_devices_last_seen")
  @@map("access_devices")
}

model AccessAuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  eventType  String   @map("event_type")
  success    Boolean  @default(true)
  email      String?
  deviceId   String?  @map("device_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")

  user AccessUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt], map: "idx_access_audit_logs_event_created")
  @@index([email, createdAt], map: "idx_access_audit_logs_email_created")
  @@index([deviceId, createdAt], map: "idx_access_audit_logs_device_created")
  @@map("access_audit_logs")
}
