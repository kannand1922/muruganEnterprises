{
  "name": "server-scanner",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "predev": "npm run prisma:generate:central",
    "dev": "nodemon src/server.js",
    "prestart": "npm run prisma:generate:central",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:central": "prisma generate --schema prisma/central/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:dbpush:central": "prisma db push --schema prisma/central/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.7.0",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "prisma": "^6.16.1"
  }
}
